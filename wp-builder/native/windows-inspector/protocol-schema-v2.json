{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wp-builder.local/schemas/windows-native-inspector-protocol-v2.json",
  "title": "wp-builder Windows native helper protocol v2",
  "x-wpb-capabilities": {
    "releaseOperations": ["inspect"],
    "experimentalOperations": ["replace"],
    "replaceStatus": "experimental-unsupported-for-production"
  },
  "$defs": {
    "identity": {
      "type": "object",
      "required": ["volumeSerial", "fileId"],
      "properties": {
        "volumeSerial": { "type": "string", "pattern": "^[0-9a-f]{16}$" },
        "fileId": { "type": "string", "pattern": "^[0-9a-f]{32}$" }
      },
      "additionalProperties": false
    },
    "expectedSnapshot": {
      "type": "object",
      "required": ["contentSha256", "size", "identity", "metadataFingerprint"],
      "properties": {
        "contentSha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "size": { "type": "string", "pattern": "^(0|[1-9][0-9]*)$" },
        "identity": { "$ref": "#/$defs/identity" },
        "metadataFingerprint": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      },
      "additionalProperties": false
    },
    "replaceEndpoint": {
      "type": "object",
      "required": ["path", "expected"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "expected": { "$ref": "#/$defs/expectedSnapshot" }
      },
      "additionalProperties": false
    },
    "validationDiagnostic": {
      "type": "object",
      "required": [
        "stage", "subject", "contentHashMatches", "sizeMatches", "volumeMatches",
        "identityMatches", "ownerMatches", "groupMatches", "daclMatches",
        "daclPresentMatches", "daclNullMatches", "protectedAclMatches", "daclAutoInheritedMatches",
        "daclAutoInheritRequiredMatches", "daclRevisionMatches", "aceCountMatches",
        "explicitAceCountMatches", "inheritedAceCountMatches", "aceOrderDigestMatches",
        "semanticAceSetDigestMatches", "accessMaskDigestMatches",
        "inheritanceFlagsDigestMatches", "trusteeDigestMatches", "aceSemanticsCompleteMatches",
        "adsMatches", "attributesMatch", "readonlyAttributeMatches", "hiddenAttributeMatches",
        "systemAttributeMatches", "archiveAttributeMatches", "temporaryAttributeMatches",
        "sparseAttributeMatches", "compressedAttributeMatches", "encryptedAttributeMatches",
        "otherAttributesMatch", "linkCountMatches", "regularFileMatches", "reparseStateMatches",
        "metadataFingerprintMatches", "actualAceCount", "expectedAceCount",
        "actualExplicitAceCount", "expectedExplicitAceCount", "actualInheritedAceCount",
        "expectedInheritedAceCount"
      ],
      "properties": {
        "stage": { "enum": ["post-replace", "post-rollback"] },
        "subject": { "enum": ["target", "backup"] },
        "contentHashMatches": { "type": "boolean" },
        "sizeMatches": { "type": "boolean" },
        "volumeMatches": { "type": "boolean" },
        "identityMatches": { "type": "boolean" },
        "ownerMatches": { "type": "boolean" },
        "groupMatches": { "type": "boolean" },
        "daclMatches": { "type": "boolean" },
        "daclPresentMatches": { "type": "boolean" },
        "daclNullMatches": { "type": "boolean" },
        "protectedAclMatches": { "type": "boolean" },
        "daclAutoInheritedMatches": { "type": "boolean" },
        "daclAutoInheritRequiredMatches": { "type": "boolean" },
        "daclRevisionMatches": { "type": "boolean" },
        "aceCountMatches": { "type": "boolean" },
        "explicitAceCountMatches": { "type": "boolean" },
        "inheritedAceCountMatches": { "type": "boolean" },
        "aceOrderDigestMatches": { "type": "boolean" },
        "semanticAceSetDigestMatches": { "type": "boolean" },
        "accessMaskDigestMatches": { "type": "boolean" },
        "inheritanceFlagsDigestMatches": { "type": "boolean" },
        "trusteeDigestMatches": { "type": "boolean" },
        "aceSemanticsCompleteMatches": { "type": "boolean" },
        "adsMatches": { "type": "boolean" },
        "attributesMatch": { "type": "boolean" },
        "readonlyAttributeMatches": { "type": "boolean" },
        "hiddenAttributeMatches": { "type": "boolean" },
        "systemAttributeMatches": { "type": "boolean" },
        "archiveAttributeMatches": { "type": "boolean" },
        "temporaryAttributeMatches": { "type": "boolean" },
        "sparseAttributeMatches": { "type": "boolean" },
        "compressedAttributeMatches": { "type": "boolean" },
        "encryptedAttributeMatches": { "type": "boolean" },
        "otherAttributesMatch": { "type": "boolean" },
        "linkCountMatches": { "type": "boolean" },
        "regularFileMatches": { "type": "boolean" },
        "reparseStateMatches": { "type": "boolean" },
        "metadataFingerprintMatches": { "type": "boolean" },
        "actualAceCount": { "type": "integer", "minimum": 0 },
        "expectedAceCount": { "type": "integer", "minimum": 0 },
        "actualExplicitAceCount": { "type": "integer", "minimum": 0 },
        "expectedExplicitAceCount": { "type": "integer", "minimum": 0 },
        "actualInheritedAceCount": { "type": "integer", "minimum": 0 },
        "expectedInheritedAceCount": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    }
  },
  "oneOf": [
    {
      "title": "Inspect request",
      "type": "object",
      "required": ["schemaVersion", "operation", "requestId", "target"],
      "properties": {
        "schemaVersion": { "const": 2 },
        "operation": { "const": "inspect" },
        "requestId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "target": {
          "type": "object",
          "required": ["path"],
          "properties": { "path": { "type": "string", "minLength": 1 } },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "title": "Replace request",
      "type": "object",
      "required": ["schemaVersion", "operation", "requestId", "target", "replacement", "backup"],
      "properties": {
        "schemaVersion": { "const": 2 },
        "operation": { "const": "replace" },
        "requestId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "target": { "$ref": "#/$defs/replaceEndpoint" },
        "replacement": { "$ref": "#/$defs/replaceEndpoint" },
        "backup": {
          "type": "object",
          "required": ["path"],
          "properties": { "path": { "type": "string", "minLength": 1 } },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "title": "Inspect response",
      "type": "object",
      "required": ["schemaVersion", "helperVersion", "requestId", "ok", "operation"],
      "properties": {
        "schemaVersion": { "const": 2 },
        "helperVersion": { "type": "string" },
        "requestId": { "type": "string" },
        "ok": { "const": true },
        "operation": { "const": "inspect" },
        "adapter": { "type": "string" },
        "architecture": { "const": "x64" },
        "filesystem": { "type": "object" },
        "file": { "type": "object" },
        "security": { "type": "object" },
        "streams": { "type": "object" },
        "compression": { "type": "object" },
        "encryption": { "type": "object" },
        "capabilities": { "type": "object" },
        "compatibility": { "type": "object" },
        "metadataFingerprint": { "type": "string" },
        "blockingReasons": { "type": "array" }
      },
      "additionalProperties": false
    },
    {
      "title": "Replace response",
      "type": "object",
      "required": ["schemaVersion", "helperVersion", "requestId", "ok", "operation", "transaction", "validation"],
      "properties": {
        "schemaVersion": { "const": 2 },
        "helperVersion": { "type": "string" },
        "requestId": { "type": "string" },
        "ok": { "const": true },
        "operation": { "const": "replace" },
        "transaction": {
          "type": "object",
          "required": ["state", "replaceFileFlags", "backupRemoved", "rollback"],
          "properties": {
            "state": { "const": "COMMITTED" },
            "replaceFileFlags": { "const": 0 },
            "backupRemoved": { "type": "boolean" },
            "rollback": {
              "type": "object",
              "required": ["attempted", "succeeded", "recoveryArtifactRetained"],
              "properties": {
                "attempted": { "type": "boolean" },
                "succeeded": { "type": "boolean" },
                "recoveryArtifactRetained": { "type": "boolean" }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "validation": {
          "type": "array",
          "items": { "$ref": "#/$defs/validationDiagnostic" }
        }
      },
      "additionalProperties": false
    },
    {
      "title": "Error response",
      "type": "object",
      "required": ["schemaVersion", "helperVersion", "requestId", "ok", "operation", "error"],
      "properties": {
        "schemaVersion": { "const": 2 },
        "helperVersion": { "type": "string" },
        "requestId": { "type": "string" },
        "ok": { "const": false },
        "operation": { "type": "string", "minLength": 1 },
        "error": {
          "type": "object",
          "required": ["code", "windowsError", "phase", "retryable"],
          "properties": {
            "code": { "type": "string" },
            "windowsError": { "type": "integer", "minimum": 0 },
            "phase": { "type": "string" },
            "retryable": { "type": "boolean" }
          },
          "additionalProperties": false
        },
        "validation": {
          "type": "array",
          "items": { "$ref": "#/$defs/validationDiagnostic" }
        }
      },
      "additionalProperties": false
    }
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wp-builder.local/windows-inspector/protocol-schema-v2.json",
  "title": "wp-builder Windows native inspector protocol v2 (inspection only)",
  "description": "Phase A protocol. Only inspect is supported; replace remains unavailable.",
  "type": "object",
  "oneOf": [
    {
      "title": "Inspect request",
      "required": ["schemaVersion", "operation", "requestId", "target"],
      "properties": {
        "schemaVersion": { "const": 2 },
        "operation": { "const": "inspect" },
        "requestId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "target": {
          "type": "object",
          "required": ["path"],
          "properties": {
            "path": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "title": "Inspect response",
      "required": ["schemaVersion", "helperVersion", "requestId", "ok", "operation"],
      "properties": {
        "schemaVersion": { "const": 2 },
        "helperVersion": { "type": "string" },
        "requestId": { "type": "string" },
        "ok": { "const": true },
        "operation": { "const": "inspect" },
        "adapter": { "const": "windows-native-inspector-v1" },
        "architecture": { "enum": ["x64", "arm64", "unknown"] },
        "filesystem": { "type": "object" },
        "file": { "type": "object" },
        "security": { "type": "object" },
        "streams": { "type": "object" },
        "compression": { "type": "object" },
        "encryption": { "type": "object" },
        "capabilities": { "type": "object" },
        "compatibility": { "type": "object" },
        "metadataFingerprint": { "type": "string" },
        "blockingReasons": { "type": "array" },
        "error": { "type": "object" }
      },
      "additionalProperties": false
    },
    {
      "title": "Protocol error response",
      "required": ["schemaVersion", "helperVersion", "requestId", "ok", "operation", "error"],
      "properties": {
        "schemaVersion": { "const": 2 },
        "helperVersion": { "type": "string" },
        "requestId": { "type": "string" },
        "ok": { "const": false },
        "operation": { "type": "string", "minLength": 1 },
        "error": {
          "type": "object",
          "required": ["code", "windowsError", "phase", "retryable"],
          "properties": {
            "code": { "type": "string" },
            "windowsError": { "type": "integer", "minimum": 0 },
            "phase": { "type": "string" },
            "retryable": { "type": "boolean" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  ]
}

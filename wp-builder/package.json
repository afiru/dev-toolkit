{
  "name": "wp-builder",
  "version": "1.0.0",
  "type": "module",
  "bin": {
    "wp-builder": "./bin/cli.mjs"
  },
  "scripts": {
    "test": "node --test test/security/security.test.mjs test/security/legacy-security-fix.characterization.test.mjs",
    "test:security": "node --test test/security/security.test.mjs test/security/legacy-security-fix.characterization.test.mjs",
    "test:security:required": "node --test test/security/security-required.test.mjs",
    "test:security:metadata": "node --test test/security/metadata.test.mjs test/security/linux-metadata.test.mjs test/security/linux-descriptor-snapshot.test.mjs test/security/linux-rollback.test.mjs",
    "test:security:ci": "node test/helpers/run-security-test-suites.mjs",
    "test:security:php-current": "node --test test/security/php-matrix.test.mjs",
    "test:security:php-required": "node --test test/security/php-matrix.test.mjs"
  },
  "dependencies": {
    "axios": "^1.18.1",
    "commander": "^12.1.0",
    "dotenv": "^17.4.2"
  }
}
